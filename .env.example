# Root Docker Compose environment for the platform
DATABASE_URL=postgresql+psycopg://app_user:app_password@postgres:5432/document_intelligence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/keys
STORAGE_PATH=/app/storage/documents
MAX_UPLOAD_SIZE_MB=10
LOG_LEVEL=INFO
ENVIRONMENT=development
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
HF_HOME=/app/model-cache
